# Local backend defaults. Docker Compose overrides DATABASE_URL with PostgreSQL.
DATABASE_URL=sqlite:///./backend/warehouse.db
CONFIG_DIR=./config
CV_BASE_URL=
CV_MIN_CONFIDENCE=0.80
EMBEDDED_MODE=mock
LOG_LEVEL=INFO
VITE_API_URL=http://localhost:8000/api/v1

# Fresh demo databases are populated automatically.
AUTO_SEED_DEMO=true
