# LOCAL DEVELOPMENT DEFAULTS
# This uses SQLite so the backend can run without Docker/PostgreSQL.
DATABASE_URL=sqlite:///./warehouse.db
CONFIG_DIR=../config
CV_BASE_URL=
CV_MIN_CONFIDENCE=0.80
EMBEDDED_MODE=mock
LOG_LEVEL=INFO

# Automatically populate a fresh empty DB with deterministic demo data.
AUTO_SEED_DEMO=true

# Optional separate CV V1 inference service, e.g. http://localhost:8100
CV_BASE_URL=
# Optional scale gateway returning JSON {"weight_kg": 12.34} on GET /weight
SCALE_BASE_URL=
